[Unit]
Description=Digital Signage safe retention
After=digital-signage.service

[Service]
Type=oneshot
User=digital-signage
Group=digital-signage
WorkingDirectory=/opt/digital-signage/app
EnvironmentFile=/etc/digital-signage/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/digital-signage/venv/bin/python /opt/digital-signage/app/deploy/linux/retention_server.py
RuntimeDirectory=digital-signage
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digital-signage-retention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/digital-signage /run/digital-signage
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

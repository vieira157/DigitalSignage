# Copy to /etc/digital-signage/server.env; root:root 0600.
# This file is EnvironmentFile syntax, NOT a shell script. No variable expansion.
DS_DB_FILE=/var/lib/digital-signage/digital_signage.db
DS_MEDIA_DIR=/var/lib/digital-signage/media
DS_RELEASE_DIR=/var/lib/digital-signage/releases
DS_INITIAL_CREDENTIALS_FILE=/var/lib/digital-signage/first_admin_credentials.txt
DS_SESSION_TTL_SECONDS=43200
DS_PASSWORD_ITERATIONS=210000
DS_COOKIE_SECURE=0
# Keep existing device-token policy during migration.
DS_REQUIRE_DEVICE_TOKEN=0
# Only needed for a NEW database. Set a private password in the real env file.
# DS_INITIAL_ADMIN_USER=admin
# DS_INITIAL_ADMIN_PASSWORD=
LIBREOFFICE_PATH=/usr/bin/libreoffice
# Application and monitor use America/Sao_Paulo explicitly.
TZ=America/Sao_Paulo
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

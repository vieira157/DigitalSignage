# Ajuste os caminhos e mantenha este arquivo legível apenas pelo usuário/administrador.
DS_DB_FILE=/var/lib/digital-signage/digital_signage.db
DS_MEDIA_DIR=/var/lib/digital-signage/media
DS_RELEASE_DIR=/var/lib/digital-signage/releases
DS_COOKIE_SECURE=1
# Ativar apenas após provisionar todas as TVs com token.
DS_REQUIRE_DEVICE_TOKEN=0
# Apenas para um banco NOVO (seu banco atual já contém administradores):
# DS_INITIAL_ADMIN_USER=admin
# DS_INITIAL_ADMIN_PASSWORD=substitua-por-uma-senha-forte

DS_TV_ID=TV01
DS_DEVICE_TOKEN=
DS_LOCAL_HOST=127.0.0.1
DS_LOCAL_PORT=8765
DS_DISABLE_HW_VIDEO_DECODE=1
# Watchdog de rede: tenta recuperar após 3 falhas de 1 min e reinicia após 15 falhas.
